/* macOS Spotlight look for rofi: rounded bar in the upper middle, results below */
configuration {
    modi: "drun";
    show-icons: true;
    icon-theme: "WhiteSur-dark";
    drun-display-format: "{name}";
    display-drun: "";
    font: "Inter 13";
    hover-select: true;
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    click-to-exit: true;
}

* {
    background-color: transparent;
    text-color: #ffffff;
}

window {
    location: north;
    anchor: north;
    y-offset: 22%;
    width: 680px;
    border: 1px;
    border-radius: 14px;
    border-color: rgba(255, 255, 255, 18%);
    background-color: rgba(40, 40, 44, 96%);
}

mainbox {
    children: [ inputbar, listview ];
    spacing: 0px;
}

inputbar {
    children: [ icon-search, entry ];
    padding: 14px 18px;
    spacing: 12px;
    border: 0px 0px 1px 0px;
    border-color: rgba(255, 255, 255, 10%);
}

icon-search {
    expand: false;
    filename: "system-search-symbolic";
    size: 24px;
    vertical-align: 0.5;
}

entry {
    placeholder: "Spotlight Search";
    placeholder-color: rgba(255, 255, 255, 45%);
    font: "Inter 19";
    vertical-align: 0.5;
    cursor: text;
}

listview {
    lines: 7;
    fixed-height: false;
    scrollbar: false;
    padding: 6px;
    spacing: 2px;
}

element {
    padding: 7px 12px;
    spacing: 12px;
    border-radius: 8px;
    cursor: pointer;
}

element selected.normal {
    background-color: #0a60ff;
}

element-icon {
    size: 30px;
    vertical-align: 0.5;
    cursor: inherit;
}

element-text {
    vertical-align: 0.5;
    cursor: inherit;
}
